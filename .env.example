# Defaults target Docker Compose production. For host-local development, use
# DATABASE_URL=file:.data/zblog.db and ZBLOG_STATE_DIR=.data instead.
DATABASE_URL=file:/app/.data/zblog.db
ZBLOG_STATE_DIR=/app/.data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Local PDF preview rendering. The Docker image installs poppler-utils, which
# provides pdftocairo.
ZBLOG_PDF_PREVIEW_COMMAND=pdftocairo
ZBLOG_PDF_RENDER_CONCURRENCY=4

# Optional automatic translation provider. Leave blank to keep translation
# disabled and run without external services.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
