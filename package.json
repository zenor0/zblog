{
  "name": "zblog",
  "version": "1.0.0",
  "description": "A self-hostable publishing site for articles, notes, and project updates.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devturbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "db:reset": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node ./src/scripts/reset-local-state.ts",
    "seed:blog": "cross-env DISABLE_PAYLOAD_HMR=true NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node ./src/scripts/seed-blog.ts",
    "seed:blog:fresh": "cross-env DISABLE_PAYLOAD_HMR=true NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node ./src/scripts/seed-blog.ts --reset",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.8",
    "@payloadcms/db-sqlite": "3.84.1",
    "@payloadcms/live-preview-react": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "biblatex-csl-converter": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "dotenv": "17.4.2",
    "fflate": "^0.8.3",
    "graphql": "^16.14.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "libsql": "0.4.7",
    "lucide-react": "^1.16.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "payload": "3.84.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/lint": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
